    "recovery:build": "bun build src/recovery-worker.ts --outdir ./dist --target node"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10.3.0"
  },
  "dependencies": {
    "@workspace/redis": "workspace:*",
    "@workspace/core": "workspace:*"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
