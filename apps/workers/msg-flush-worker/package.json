{
  "name": "msg-flush-worker",
  "module": "src/worker.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/worker.ts",
    "recovery:dev": "bun run --watch src/recovery-worker.ts",
