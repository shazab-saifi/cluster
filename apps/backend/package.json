{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "AWS_PROFILE=cluster-s3-dev bun --bun --watch src/index.ts",
    "build": "bun --bun build src/index.ts --target bun --outdir dist",
    "start": "bun --bun start dist/index.js",
    "lint": "bunx eslint --fix",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@types/bun": "latest",
    "eslint": "^10.2.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@workspace/core": "workspace:*",
    "@workspace/auth": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^4.3.6"
  }
}
